   "files": [],
   "drive": null,
   "phone": "972533626264"
  },
  {
   "id": "3EB08068DF1F4FCC437BDF",
   "sender": "אני",
   "text": "ותאשרו לי שכולם מסכימים ונשלח לרב בית הספר - שביקש",
   "ts": 1784528456000,
   "date": "2026-07-20",
   "time": "09:20",
   "files": [],
   "drive": null
  },
  {
   "id": "AC285899E99C31F81CA04F8AD72BD061",
   "sender": "0533626264",
   "text": "לא הבנתי אז מה אתה אומר, אתה מדבר לשלוח את העבודות למישהו אחר?",
   "ts": 1784528596000,
   "date": "2026-07-20",
   "time": "09:23",
