  {
   "id": "95A93737833FBD03E96DE1A081FDCD74",
   "sender": "0507958992",
   "text": "אתם מוזמנים לקרא להדפיס, לערוך באופן שיתאים לתלמידים, מה שנכון לכם.",
   "ts": 1753620644000,
