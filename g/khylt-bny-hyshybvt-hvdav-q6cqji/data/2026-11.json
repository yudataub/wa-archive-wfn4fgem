.co.il ולציין : שם ,טלפון, סניף  וכתובת מייל לקבלת אישור הזמנה.","ts":1794133350000,"date":"2026-11-08","time":"12:22","files":[],"drive":null,"phone":"972529407610"},{"id":"AC7D409D09633C2BBFF91FEC58983AEE","sender":"אלקנה","text":"","ts":1794133350000,"date":"2026-11-08","time":"12:22","files":[{"name":"חיפה 2.12.pdf","size":"552KB","type":"application/pdf","path":"https://drive.google.com/file/d/1qvCxFLWt96VkYktDPeKbLpQhymsE3u7Z/view?usp=drivesdk","skipped":""}],"drive":null,"phone":"972529407610"},{"id":"ACA8DE9C79F8237CCE6E639B9BDE9251","sender":"אלקנה","text":"לקראת חנוכה מכירת בשר בחיפה  בהכשר הרב לוין -כ\"ב כסלו","ts":1794133350000,"date":"2026-11-08","time":"12:22","files":[],"drive":null,"phone":"972529407610"},{"id":"3A2ACA8D9FE80DF97A00","sender":"יהודה גיבטובסקי","text":"צריך לשלוח חבילה קטנה מאד לעפולה , אם מישהו נוסע היום או מחר אשמח לדעת","ts":1794137858000,"date":"2026-11-08","time":"13:37","files":[],"drive":null,"phone":"972534961329"},{"id":"3EB088E397194FD97D2391","sender":"ישי","text":"","ts":1794147808000,"date":"2026-11-08","time":"16:23","files":[{"name":"תמונה.jpg","size":"107KB","type":"image/jpeg","path":"https://yudataub.github.io/wa-vid-khylt-bny-hyshybvt-hvdav-q6cqji/f/2026-11/3EB088E397194FD97D2391_0.jpg","skipped":"","spool":"2026-11/3EB088E397194FD97D2391_0.jpg","mirror":"https://yudataub.github.io/wa-vid-khylt-bny-hyshybvt-hvdav-q6cqji/f/2026-11/3EB088E397194FD97D2391_0.jpg"}],"drive":null,"phone":"972527617538"},{"id":"AC611DE75D2FD03C1431DA8D371F6482","sender":"י.  כהן","text":"מספר הטלפון של נועם טבצ'ניק","ts":1794160414000,"date":"2026-11-08","time":"19:53","files":[],"drive":null,"phone":"972555649000"},{"id":"AC2D1BF7C90F402E82FDFF4FC927384A","sender":"יעקב קרלינסקי","text":"📇 נועם אינהורן\n+972523839989","ts":1794166214000,"date":"2026-11-08","time":"21:30","files":[],"drive":null,"phone":"972552748485"}]}