3:48","files":[],"drive":null,"phone":"972546334622"},{"id":"8796C4F163AE47E61AC10595EBE4C011","sender":"0546334622","text":"","ts":1717757424000,"date":"2024-06-07","time":"13:50","files":[{"name":"IMG-20240607-WA0058.jpg","size":"186KB","type":"image/jpeg","path":"https://drive.google.com/file/d/1eWCzJNUis8RoQ1ImxSEWYnkJQCZZ-z8k/view?usp=drivesdk","skipped":"","thumb":"https://drive.google.com/thumbnail?id=1eWCzJNUis8RoQ1ImxSEWYnkJQCZZ-z8k&sz=w1200"}],"drive":null,"phone":"972546334622"},{"id":"BD58D3868348D1A0D4DB67E0D99A1814","sender":"Ora אורה קרן מנהל מכללת קרית אתא","text":"יקירי שמחה מאוד לתגובותיכם מחממות הלב . בקרוב ,בע\"ה ,יפתח קורס נוסף. שבת שלום וחג שמח. בתקווה שיהיה שקט וחגיגי באמת . 🌹🍀🌹\nהמדיניות שלנו במכללה, להענות לרצונות הציבור . אם אתם מעונינים בנושא מסויים דברו איתי. . ואם כבר יש לכם קבוצת אנשים המעונינים בנושא זה על אחת כמה וכמה. 🍀🌹\nהטלפון שלי0505729838\nשלכם : ד\"ר אורה קורן מנהלת מכללת אתא .🌹","ts":1717759550000,"date":"2024-06-07","time":"14:25","files":[],"drive":null,"phone":"972505729838"},{"id":"A73881B2BD4B6414B9C1F18E6A3CDA6B","sender":"0522838475","text":"ז'ק היקר, מלוא ההערכה והכבוד על העברת הסדנה. העשרת מאוד את הידע שלי ועל כך מלוא המחמאות. 🙏🙏🙏\nשבת שלום לכולם","ts":1717772805000,"date":"2024-06-07","time":"18:06","files":[],"drive":null,"phone":"972522838475"},{"id":"6F82722012DFD6C22919CA981D501955","sender":"0506522952","text":"לג׳ק ואורה.\nאני הייתי רק בחלק הראשון שהתקיים ביום חמישי.\nחוץ משם של אפליקציה לעיבוד תמונה לא למדתי דבר חדש. \nעזבתי ברגע שז'ק שאל כמה זה מיליונית השניה.\nבאתי ללמוד איך להפיק את המירב מהמצלמה שלי. לא באתי לשיעור פיזיקה ובטח שלא להצגת תכלית של כמה מהתמונות הטובות ביותר שג׳ק ערך בחייו.\nאני יודעת שאני לא היחידה שיצאה לא מרוצה.","ts":1717774701000,"date":"2024-06-07","time":"18:38","files":[],"drive":null,"phone":"972506522952"},{"id":"51322D9B46761557CBD58F0D4F2ABD44","sender":"Ora אורה קרן מנהל מכללת קרית אתא","text":"","ts":1718085821000,"date":"2024-06-11","time":"09:03","files":[{"name":"IMG-20240611-W