:1791990158000,"date":"2026-10-14","time":"18:02","files":[{"name":"תמונה.jpg","size":"333KB","type":"image/jpeg","path":"https://drive.google.com/file/d/1ARilx5P1KIdpUgmMOX_d25sOrF_x-6BV/view?usp=drivesdk","skipped":"","thumb":"https://drive.google.com/thumbnail?id=1ARilx5P1KIdpUgmMOX_d25sOrF_x-6BV&sz=w1200"}],"drive":null,"phone":"972543453284"},{"id":"AC650522BFD497F14F5F5921BDA06B0F","sender":"קרן פלט🌸","text":"🙏🙏","ts":1791990487000,"date":"2026-10-14","time":"18:08","files":[],"drive":null,"phone":"972502028311"},{"id":"AC6189327DC9FE490591E78B72B19993","sender":"מירה פריד","text":"","ts":1791992168000,"date":"2026-10-14","time":"18:36","files":[{"name":"מידותיו של משה רבנו - קישוט לכתה.pdf","size":"650KB","type":"application/pdf","path":"https://drive.google.com/file/d/1nA7Xrx1cI4R0GqUA4uFse8GidxVnxqWH/view?usp=drivesdk","skipped":""}],"drive":null,"phone":"972543453284"},{"id":"AC545893FACBF68889F7A01C89157D4E","sender":"מירה פריד","text":"מצאו לי😍","ts":1791992169000,"date":"2026-10-14","time":"18:36","files":[],"drive":null,"phone":"972543453284"},{"id":"AC3757D9D08B1C7D6901D9A97A3A94D5","sender":"יזהר פינטוס","text":"גרפיקה וניקוד מותאמים לתחילת יסודי.\nמסרים חינוכיים בסה\"כ חיוביים.\nעם זאת, הכל מבוסס מדרשים ופרשנים, שזה דבר לא תואם גיל בכלל! \nאני מחזק,את המגמה לקיים שיח ערכים בכיתה - אבל צמוד פשט. ויש ברוך ה' המון מה ללמוד ממידותיו של משה על פי הפשט!\n\nעזר לבנות של יתרו - בסיס לשיח על מידותיו!\nפעל להגן על מי שחלש, כולל כשידע שזה יסבך אותו - עוד מוקד תוכן של ערכים!\nמבקש מה' שימצא מישהו אחר שינהיג - גם מראה דבר משמעותי לגבי אישיותו!\n\nואת הדוגמאות האלו אפשר לנעוץ בפסוקים, לתת משימות לתלמידים שבהן ימצאו את הפרטים הללו בפועל מקריאה בחומש.\nכבר יצא לי לראות מורה שהכינה מבחן עם שאלה שכדי לענות עליה הילד צריך לזכור מדרש שסיפרה בכיתה בעל פה. זה לא סביר, כי הוא לא יכול לברר את התשובה מתוך החומש","ts":1791992742000,"date":"2026-10-14","time":"18:45","files":[],"drive":null,"phone":"972508808857"},{"id":"AC234D5DDC1114354F76E2324FD826D6","sender":"מירה פריד","text":"מסכימה עם הדברים, ובאמת בעיקר מתרכזת בפשט.\nבנוסף- זה קישוט לאחר הלימוד.\nבעצם למדנו את הפסוקים, ניסינו להבין מתוך המעשים מה ניתן ללמוד על משה רבנו ורק אז תולה בכתה.","ts":1791998602000,"date":"2026-10-14","time":"20:23","files":[],"drive":null,"phone":"972543453284"},{"id":"ACF28CDCD72C4AEAC59A543ABAC2F61B","sender":"הודיה קליגר","text":"למשהו יש קישור לאתר הדרכה של חגי לב? \n(הקישור בללמוד וללמד לא תקין)","ts":1792045671000,"date":"2026-10-15","time":"09:27","files":[],"drive":null,"phone":"972584006075"},{"id":"ACF83DEC5F0ED794659BB96DCCDD783A","sender":"איריס זמיר","text":"יש למישהו דף קריאה לפרשה מנוקד  שמתאים  לכתות ג ?","ts":1792103659000,"date":"2026-10-16","time":"01:34","files":[],"drive":null,"phone":"972546159578"},{"id":"AC482463C3E8133DE6C74988E5450FF3","sender":"רחלי בלמס","text":"","ts":1792122506000,"date":"2026-10-16","time":"06:48","files":[{"name":"נח-החיות-בתיבה-דף-קריאה.pdf","size":"136KB","type":"application/pdf","path":"https://drive.google.com/file/d/19Q0Mez59E3y8UWzKtn1bLHOKeeMLFDop/view?usp=drivesdk","skipped":""}],"drive":null,"phone":"972584324242"},{"id":"ACBEC5940C1DDEC79E9ED48A39F61FF2","sender":"רחלי בלמס","text":"","ts":1792122509000,"date":"2026-10-16","time":"06:48","files":[{"name":"נח-המבול-דף-קריאה.pdf","size":"242KB","type":"application/pdf","path":"https://drive.google.com/file/d/1CexbXiNZNQLyKVT8KNwNvo3ItLF_paE7/view?usp=drivesdk","skipped":""}],"drive":null,"phone":"972584324242"},{"id":"AC92B422F93DC1534E30FC4773116A06","sender":"איריס זמיר","text":"שבוע טוב , מה ההבדל בין הקבוצות , זה לא חוזר עצ עצמו ..?","ts":1792273543000,"date":"2026-10-18","time":"00:45","files":[],"drive":null,"phone":"972546159578"},{"id":"AC7833A8A07ED9D83B87E62F83C2DAA0","sender":"ARAZI SHARONA","text":"שבוע טוב אלו קבוצות פרטיות...לא מטעמנו ולא בפיקוח. \nשימו לב להגדרות הקבוצה. אין להעלות קישורים שאינן מטעם החמ\"ד!!","ts":1792287255000,"date":"2026-10-18","time":"04:34","files":[],"drive":null,"phone":"972502123444"},{"id":"ACF1BF3A67FE69