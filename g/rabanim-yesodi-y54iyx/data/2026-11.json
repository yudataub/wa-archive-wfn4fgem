-11-01","time":"09:44","files":[],"drive":null,"phone":"972539237263"},{"id":"AC2267F57D67403BAB19B07AB37987A2","sender":"אפי","text":"פרקי אבות זהו אוצר של מידות טובות.\nלמה נקראו אבות?\nכי הם מולידים המון מעשים טובים כמו שורשים שמצמיחים ובונים את החיים.              מצורף טופס ללמידה- יש לציין בו או בדף נפרד (אפשר בכתב יד) ניקוד מצטבר. בטופס זה יש קישורים לסרטונים     \n\nhttps://docs.google.com/document/d/1swoR57jJsOKPOejxGPSkarM36uhgwyDEetD25Dndhg8/edit?usp=sharing \n(התלהבות\\טיפשות\\התעלות מראייה קטנה\\ קנאה מכלה\\ איפה הרע נמצא) \n\nזה חלקי ראה בקישור.\n\nאם רוצה עוד או הטקסט שהכין הסרטון ועוד סרטונים (על אבות) נא פנה בפרטי...","ts":1793519159000,"date":"2026-11-01","time":"09:45","files":[],"drive":null,"phone":"972543118860"},{"id":"3A459680BE9579AEB291","sender":"עותניאל מנצור","text":"🌞 בוקר טוב ושבוע מבורך!\n\nבימים הקרובים יופק סרטון סיכום לאירועי שבת ההוקרה לצוותי החינוך, שבת מרגשת ומשמעותית שזכינו לציין יחד השבת.\n\nכל מי שברשותו תמונות או סרטונים מאירועים ומפעילויות שהתקיימו לקראת השבת, ומעוניין לשתף אותם לצורך הכנת הסרטון, מוזמן לשלוח אותם ישירות אלי.\n\nנשמח לכל שיתוף שיסייע לנו לתעד את ההתרגשות, ההוקרה והעשייה המבורכת! 🙏","ts":1793519166000,"date":"2026-11-01","time":"09:46","files":[],"drive":null,"phone":"972524700429"},{"id":"AC667A3F410CE8948F623F10247068FF","sender":"אפי","text":"","ts":1793519182000,"date":"2026-11-01","time":"09:46","files":[{"name":"מדבקה.webp","size":"18KB","type":"image/webp","path":"media/2026-11/AC667A3F410CE8948F623F10247068FF_1.webp","skipped":""}],"drive":null,"phone":"972543118860"},{"id":"AC1AF10897B2FB13CD19133065E32544","sender":"אפי","text":"יש גם מדבקה חמודה שילדים יצרו... אם יוצר עוד אשמח לקבל..","ts":1793519208000,"date":"2026-11-01","time":"09:46","files":[],"drive":null,"phone":"972543118860"},{"id":"3AC7355717BC31E05DD3","sender":"דביר מימון","text":"שבוע טוב ,\nיש אמא שקונה ספרי קריאה לכיתה מדני ספרים יש ספרים שאתה מכיר שהם טובים היא רוצה המלצה ?","ts":1793523833000,"date":"2026-11-01","time":"11:03","files":[],"drive":null,"phone":"972527994207"},{"id":"3A408D67E0E6608127BA","sender":"דביר מימון","text":"שלום, אם מישנו מכיר ויכול להמליץ לי אשמח🙏🏼","ts":1793523869000,"date":"2026-11-01","time":"11:04","files":[],"drive":null,"phone":"972527994207"},{"id":"3EB0E96267B161DBF75B71","sender":"shmu54","text":"ביום שני הבא, כ\"ט בחשון, יחול חג הסיגד של העולים היקרים מאתיופיה. להלן חומר על תרומתו הגדולה של חנן פורת ז\"ל לעלייתם ולקליטתם בארץ. וכן דברי תורה שלו ונקודות ציון מחייו שניתן לקשר לחג הסיגד - כיסופים לירושלים והמקדש, עלייה לארץ ישראל למרות הקשיים הרבים, קיבוץ גלויות מארץ נידחת. בהצלחה. https://docs.google.com/presentation/d/1oL3oVnpsXxcpsea258JMejs2XI0ZpoBE/edit?usp=sharing&ouid=104637392439041079330&rtpof=true&sd=true","ts":1793526412000,"date":"2026-11-01","time":"11:46","files":[],"drive":null,"phone":"972586522072"},{"id":"ACF16C4E4F9E848782FE23718336E13F","sender":"יואל בר חן","text":"שלום. למישהו חברותיות על זהירות בדרכים??","ts":1793530246000,"date":"2026-11-01","time":"12:50","files":[],"drive":null,"phone":"972526096407"},{"id":"AC9F41CD964D41EDFA9E843786C69823","sender":"אליהו טרבלסי","text":"","ts":1793538353000,"date":"2026-11-01","time":"15:05","files":[{"name":"תמונה.jpg","size":"180KB","type":"image/jpeg","path":"media/2026-11/AC9F41CD964D41EDFA9E843786C69823_1.jpg","skipped":""}],"drive":null,"phone":"972544518399"},{"id":"3EB0320958291B42B3AED0","sender":"אליהו טרבלסי","text":"","ts":1793540312000,"date":"2026-11-01","time":"15:38","files":[{"name":"תמונה.jpg","size":"182KB","type":"image/jpeg","path":"media/2026-11/3EB0320958291B42B3AED0_1.jpg","skipped":""}],"drive":null,"phone":"972544518399"},{"id":"3EB03B118C7B856CF00B1E","sender":"אליהו טרבלסי","text":"","ts":1793540313000,"date":"2026-11-01","time":"15:38","files":[{"name":"תמונה.jpg","size":"178KB","type":"image/jpeg","path":"media/2026-11/3EB03B118C7B856CF00B1E_1.jpg","skipped":""}],"drive":null,"phone":"972544518399"},{"id":"3EB005BFAAE9622B618D27","sender":"אליהו טרבלסי","text":"","ts"